# =============================================
# LAO_AI_INVESTMENT_OS — Environment Config
# Copy this to .env and fill in real values.
# NEVER commit the real .env to version control.
# =============================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lao_ai_db

# JWT Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Learning System
ADMIN_LOCK=false  # Set to "true" to halt AI weight updates and trigger rollback

# Market Data APIs (Phase 11)
# BINANCE_API_KEY=
# BINANCE_SECRET=
# ALPHA_VANTAGE_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
